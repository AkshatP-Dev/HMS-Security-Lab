# HMS Security Lab — Environment Variable Reference
# Copy this file to .env and fill in real values.
# NEVER commit a .env file with real secrets to version control.

# ── Secure app (port 5001) ────────────────────────────────

# Flask session signing key.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# or:            openssl rand -hex 32
HMS_SECRET_KEY=CHANGE_ME_replace_with_32_byte_random_hex

# Set to "true" only when running behind a TLS terminator (nginx/Caddy).
# Leave "false" for local HTTP testing.
HTTPS=false

# Set to "true" only in local development — NEVER in production.
FLASK_DEBUG=false

# ── Insecure app (port 5000) ──────────────────────────────
# The insecure app has no configurable secrets — it uses hardcoded values
# deliberately as part of the training demonstration (VULN-01).
# Do not add secrets here for the insecure app; they would never be used.
